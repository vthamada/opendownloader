{
  "manifest_version": 3,
  "minimum_chrome_version": "106",
  "name": "OpenDownloader",
  "version": "0.6.0",
  "description": "Envie arquivos e vídeos ao OpenDownloader ou grave a reprodução com escolha explícita da fonte.",
  "permissions": [
    "contextMenus",
    "nativeMessaging",
    "storage",
    "activeTab",
    "scripting"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Enviar um link ao OpenDownloader",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
